PORT=3000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:4200
# Render: set HOST=0.0.0.0 and FRONTEND_URL to your exact Vercel origin.
# Copy this file to .env and add your private Atlas connection string.
# Leave MONGODB_URI empty only for local JSON storage.
MONGODB_URI=
MONGODB_DB=yps
# DATA_DIR applies only to local JSON storage when MONGODB_URI is empty.
